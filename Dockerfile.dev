FROM node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git postgresql-client socat \
 && rm -rf /var/lib/apt/lists/*
# Docker CLI so the Supabase CLI can manage the local stack through the host socket.
COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker
# Chromium for Playwright, so `npm test` runs every suite in this one container.
RUN npx -y playwright@1.65.1 install --with-deps chromium
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 \
    WATCHPACK_POLLING=true \
    NEXT_WATCH_POLL=1
COPY docker/dev-entrypoint.sh /usr/local/bin/dev-entrypoint
RUN chmod +x /usr/local/bin/dev-entrypoint
EXPOSE 3000
ENTRYPOINT ["dev-entrypoint"]
CMD ["npm", "run", "dev"]
